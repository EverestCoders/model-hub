							"listen": "test",
							"script": {
								"exec": [
									"const responseJson = pm.response.json();",
									"if (responseJson.id) {",
									"    pm.environment.set('modelId', responseJson.id);",
									"    pm.environment.set('versionId', responseJson.version.id);",
									"}"
								],
